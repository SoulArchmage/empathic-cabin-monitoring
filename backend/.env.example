# ===================== 服务基础 =====================
# 监听地址与端口由启动命令决定：python -m uvicorn app.main:app --host 0.0.0.0 --port 8000
LOG_LEVEL=INFO

# ===================== 数据接入层 =====================
# simulator（内置模拟器，推荐离线演示） | external（对接真实情绪/脑电系统）
SOURCE_MODE=simulator
SAMPLE_HZ=10
# SOURCE_MODE=external 时必填
EXTERNAL_STATE_URL=

# ===================== 触发引擎（抗幻觉第一道防线）=====================
TRIGGER_WINDOW=15
TRIGGER_MIN_CONSEC=10
TRIGGER_RATIO=0.6
TRIGGER_COOLDOWN_S=60
TRIGGER_RECOVERY_FRAMES=20
# 异常持续超过该秒数才升级为 severe（触发"安全出口"专业转介）
TRIGGER_ESCALATE_AFTER_S=8

# ===================== 持久化 =====================
DB_URL=sqlite+aiosqlite:///./data/soothe.db
PERSIST_HZ=1

# ===================== 大模型适配层 =====================
# mock（无需 Key，默认） | deepseek | zhipu | qwen | openai
# 切换厂商只需改前两行：把 LLM_PROVIDER 改成厂商名，LLM_API_KEY 填上对应 Key
LLM_PROVIDER=mock
LLM_API_KEY=
# 留空则使用厂商默认：deepseek→deepseek-flash / zhipu→glm-4-flash
#                    qwen→qwen-plus / openai→gpt-4o-mini
LLM_MODEL=
# 留空则使用厂商默认接入地址；自建网关或代理时填写
LLM_BASE_URL=
LLM_TIMEOUT_S=20
LLM_MAX_RETRY=1

# ===================== 语音适配层 =====================
# ASR：mock（无需 Key，返回演示语料） | openai（OpenAI Whisper 兼容接口，自建网关同样适用）
ASR_PROVIDER=mock
ASR_API_KEY=
# 留空则使用默认 https://api.openai.com/v1 + whisper-1；自建/代理网关时填写
ASR_BASE_URL=
ASR_MODEL=
ASR_TIMEOUT_S=20
# TTS：mock（浏览器 speechSynthesis 播报） | edge（需 pip install edge-tts）
TTS_PROVIDER=mock
TTS_VOICE=zh-CN-XiaoxiaoNeural

# ===================== WebSocket =====================
WS_QUEUE_SIZE=64
# 同一语音连接两次上行之间的最小间隔（秒），用于避免高频调用放大模型成本
VOICE_MIN_INTERVAL_S=1
